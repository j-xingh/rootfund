# Copy this file to .env and fill it in. NEVER commit .env (it is in .gitignore).

# mock = no PayPal credentials needed (for building the UI offline). sandbox = real PayPal sandbox.
PAYPAL_MODE=mock

# Public address of THIS app. Local: http://localhost:3000   Render: https://<your-service>.onrender.com
PUBLIC_BASE_URL=http://localhost:3000
PORT=3000

# From developer.paypal.com > Apps & Credentials (Sandbox) > your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# From the app's Webhooks section after you register PUBLIC_BASE_URL/api/webhooks/paypal
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Sandbox PERSONAL account emails that receive payouts (comma separated, at least 3)
PROJECT_OWNER_EMAILS=

# MongoDB Atlas connection string. Leave empty to use in-memory storage (data resets on restart).
MONGODB_URI=

# Secret for the admin buttons (attack, refund, settle, reset). Change it!
ADMIN_KEY=change-me

# Matching pool in USD. Keep it small; payouts come from your sandbox business balance.
POOL_USD=100
